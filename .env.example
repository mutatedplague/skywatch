# ---------------------------------------------------------------------------
# Where the scope is standing. Everything on the radar is measured from here,
# so put in your actual rooftop position — decimal degrees, south and west
# negative. Without these two values SKYWATCH runs on simulated traffic.
# ---------------------------------------------------------------------------
HOME_LAT=39.7392
HOME_LON=-104.9903
SITE_NAME=HOME

# ---------------------------------------------------------------------------
# Where the aircraft come from.
#
#   dump1090       your own receiver (RTL-SDR). Needs DUMP1090_URL.
#   adsblol        adsb.lol community feed, free, no account
#   airplaneslive  airplanes.live community feed, free, no account
#   opensky        OpenSky Network (see credentials below)
#   demo           synthetic traffic, for working on the UI
# ---------------------------------------------------------------------------
ADSB_SOURCE=dump1090

# Bundled receiver container (docker compose --profile sdr up -d):
DUMP1090_URL=http://dump1090:8080/data/aircraft.json
# A dump1090 already running on this machine, outside Docker:
# DUMP1090_URL=http://host.docker.internal:8080/data/aircraft.json
# A Raspberry Pi or PiAware box elsewhere on your network:
# DUMP1090_URL=http://192.168.1.50:8080/data/aircraft.json

# ---------------------------------------------------------------------------
# Radio settings (only used by the bundled dump1090 container)
# ---------------------------------------------------------------------------
# Leave DUMP1090_DEVICE empty for the first dongle found, or set an index or
# serial number when you have more than one.
DUMP1090_DEVICE=
DUMP1090_DEVICE_TYPE=rtlsdr
# "adaptive" lets dump1090 manage gain itself. A number pins it in dB;
# -10 hands control to the tuner's own AGC.
DUMP1090_GAIN=adaptive
DUMP1090_MAX_RANGE_NM=300
DUMP1090_VERSION=v11.1
DUMP1090_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# Airspace
# ---------------------------------------------------------------------------
# How far out the receiver pulls traffic. The scope zooms within this.
RANGE_NM=100
# A contact closer than ALERT_RADIUS_NM and lower than ALERT_ALTITUDE_FT is
# flagged overhead: amber on the scope, promoted in the contact list.
ALERT_RADIUS_NM=3
ALERT_ALTITUDE_FT=12000
# Drop a contact this many seconds after its last position report.
STALE_SECONDS=75
# Poll interval in ms. Leave empty to use the sensible default per source.
POLL_MS=

# ---------------------------------------------------------------------------
# OpenSky Network (only needed when ADSB_SOURCE=opensky)
# Register at https://opensky-network.org and create an API client.
# ---------------------------------------------------------------------------
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Ports and networking
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=4000
DUMP1090_PORT=8080
CORS_ORIGIN=*
# Set only when the API is behind a reverse proxy on a different origin,
# e.g. https://radar.example.com/api . Otherwise the browser works it out.
NEXT_PUBLIC_API_URL=
